{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Apprenticeship Training Density Across Australian States & Territories",
    "subtitle": "Active apprentices & trainees per 1,000 employed workforce members (2021–2025). Sources: NCVER & ABS Labour Force",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 450,
  "params": [
    {
      "name": "Year_Select",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2021,
        "max": 2025,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [133.5, -28],
    "scale": 600
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/ncver_abs_state_summary.csv"
            },
            "key": "State_Name",
            "fields": [
              "Workforce_Thousands",
              "In_Training_2021", "In_Training_2022", "In_Training_2023", "In_Training_2024", "In_Training_2025",
              "Density_2021", "Density_2022", "Density_2023", "Density_2024", "Density_2025"
            ]
          }
        },
        {"calculate": "datum['Density_' + Year_Select]", "as": "Apprentices_Per_1000_Workers"},
        {"calculate": "datum['In_Training_' + Year_Select]", "as": "In_Training_Count"}
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "color": {
          "field": "Apprentices_Per_1000_Workers",
          "type": "quantitative",
          "title": "Per 1,000 Workers",
          "scale": {
            "type": "linear",
            "domain": [18, 38],
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 160
          }
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "type": "nominal", "title": "State / Territory"},
          {"field": "Apprentices_Per_1000_Workers", "type": "quantitative", "format": ".1f", "title": "Per 1,000 Workers"},
          {"field": "In_Training_Count", "type": "quantitative", "format": ",", "title": "In Training"},
          {"field": "Workforce_Thousands", "type": "quantitative", "format": ",", "title": "Employed Workforce ('000s)"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 144.5, "lat": -22.5, "text": "Queensland: 29.2 apprentices / 1,000 workers"},
          {"lon": 122.0, "lat": -26.0, "text": "Western Australia: Heavy trade & resources focus"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {"stroke": null}
  }
}
