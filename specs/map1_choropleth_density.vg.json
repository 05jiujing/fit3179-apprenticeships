{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Apprenticeship Training Density Across Australian States & Territories",
    "subtitle": "Active apprentices & trainees per 1,000 employed workforce members (2015–2024). Sources: NCVER & ABS",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 450,
  "params": [
    {
      "name": "Year_Select",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2024,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [134, -28],
    "scale": 620
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/ncver_abs_state_summary.csv"
      },
      "transform": [
        {"filter": "datum.Year == Year_Select"},
        {
          "lookup": "State_Name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/australia_states.geojson",
              "format": {"type": "json", "property": "features"}
            },
            "key": "properties.STATE_NAME",
            "fields": ["type", "geometry", "properties"]
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "Apprentices_Per_1000_Workers",
          "type": "quantitative",
          "title": "Per 1,000 Workers",
          "scale": {
            "type": "linear",
            "domain": [18, 38],
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 160
          }
        },
        "tooltip": [
          {"field": "State_Name", "type": "nominal", "title": "State / Territory"},
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Apprentices_Per_1000_Workers", "type": "quantitative", "format": ".1f", "title": "Per 1,000 Workers"},
          {"field": "In_Training_Total", "type": "quantitative", "format": ",", "title": "Total In Training"},
          {"field": "Trades_Count", "type": "quantitative", "format": ",", "title": "Trade Apprentices"},
          {"field": "Non_Trades_Count", "type": "quantitative", "format": ",", "title": "Trainees (Non-Trade)"},
          {"field": "Workforce_Thousands", "type": "quantitative", "format": ",", "title": "Employed Workforce ('000s)"},
          {"field": "Completion_Rate_Pct", "type": "quantitative", "format": ".1f", "title": "Cohort Completion Rate (%)"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 144.5, "lat": -22.5, "text": "Queensland: Highest mainland per-capita intake (29.2/1k)"},
          {"lon": 122.5, "lat": -26.0, "text": "Western Australia: Heavy trade concentration (76.0%)"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {"stroke": null}
  }
}
