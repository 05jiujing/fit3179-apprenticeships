{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "params": [
    {
      "name": "Year_Select",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2021,
        "max": 2025,
        "step": 1,
        "name": "Year (June quarter): "
      }
    }
  ],
  "projection": {
    "type": "albers",
    "rotate": [-134, 0],
    "parallels": [-18, -36],
    "center": [0, -27],
    "scale": 700
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/ncver_abs_state_summary.csv"
            },
            "key": "State_Name",
            "fields": [
              "Workforce_Thousands",
              "In_Training_2021", "In_Training_2022", "In_Training_2023", "In_Training_2024", "In_Training_2025",
              "Density_2021", "Density_2022", "Density_2023", "Density_2024", "Density_2025"
            ]
          }
        },
        {"calculate": "datum['Density_' + Year_Select]", "as": "Apprentices_Per_1000_Workers"},
        {"calculate": "datum['In_Training_' + Year_Select]", "as": "In_Training_Count"}
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "color": {
          "field": "Apprentices_Per_1000_Workers",
          "type": "quantitative",
          "title": "Per 1,000 Workers",
          "scale": {
            "type": "linear",
            "domain": [18, 38],
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "type": "nominal", "title": "State / Territory"},
          {"field": "Apprentices_Per_1000_Workers", "type": "quantitative", "format": ".1f", "title": "Per 1,000 Workers"},
          {"field": "In_Training_Count", "type": "quantitative", "format": ",", "title": "In Training"},
          {"field": "Workforce_Thousands", "type": "quantitative", "format": ",", "title": "Employed Workforce ('000s)"}
        ]
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600,
             "labelColor": "#475569", "titleColor": "#0f172a", "gridColor": "#e2e8f0", "domainColor": "#cbd5e1"},
    "legend": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600},
    "text": {"font": "Plus Jakarta Sans"}
  }
}
