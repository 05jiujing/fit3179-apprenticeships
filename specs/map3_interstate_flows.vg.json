{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Equal-Area Spatial Cartogram: State Completion Rates",
    "subtitle": "Hexagonal geographic tile cartogram eliminating landmass distortion (2024). Source: NCVER",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 450,
  "data": {
    "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/australia_hex_cartogram.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "hexagon",
        "size": 6500,
        "filled": true,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Grid_Col",
          "type": "quantitative",
          "scale": {"domain": [0.3, 4.7]},
          "axis": null
        },
        "y": {
          "field": "Grid_Row",
          "type": "quantitative",
          "scale": {"domain": [0.4, 5.6], "reverse": true},
          "axis": null
        },
        "color": {
          "field": "Completion_Rate_Pct",
          "type": "quantitative",
          "title": "Completion Rate (%)",
          "scale": {
            "type": "linear",
            "domain": [53, 62],
            "scheme": "purples"
          },
          "legend": {
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 160
          }
        },
        "tooltip": [
          {"field": "State_Name", "type": "nominal", "title": "State / Territory"},
          {"field": "Active_Apprentices", "type": "quantitative", "format": ",", "title": "Active Apprentices"},
          {"field": "Completion_Rate_Pct", "type": "quantitative", "format": ".1f", "title": "Cohort Completion Rate (%)"},
          {"field": "Trade_Share_Pct", "type": "quantitative", "format": ".1f", "title": "Trade Share (%)"},
          {"field": "Dominant_Sector", "type": "nominal", "title": "Dominant Industry Focus"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 800,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#ffffff",
        "dy": -8
      },
      "encoding": {
        "x": {"field": "Grid_Col", "type": "quantitative"},
        "y": {"field": "Grid_Row", "type": "quantitative"},
        "text": {"field": "State_Code", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#f1f5f9",
        "dy": 10
      },
      "encoding": {
        "x": {"field": "Grid_Col", "type": "quantitative"},
        "y": {"field": "Grid_Row", "type": "quantitative"},
        "text": {"field": "Completion_Rate_Pct", "type": "quantitative", "format": ".1f"}
      }
    },
    {
      "data": {
        "values": [
          {"col": 4.1, "row": 2.2, "text": "ACT: Highest completion (61.2%)"},
          {"col": 1.2, "row": 1.2, "text": "Equal-area geometry balances small jurisdictions"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#64748b"
      },
      "encoding": {
        "x": {"field": "col", "type": "quantitative"},
        "y": {"field": "row", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {"stroke": null}
  }
}
