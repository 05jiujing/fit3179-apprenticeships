{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Interstate Training Mobility & Cross-Border Delivery",
    "subtitle": "Major apprentice and trainee cross-border training contract movements (2024)",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 450,
  "params": [
    {
      "name": "Min_Trainees",
      "value": 1000,
      "bind": {
        "input": "range",
        "min": 800,
        "max": 5000,
        "step": 200,
        "name": "Min Flow Volume: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [134, -28],
    "scale": 620
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f8fafc",
        "stroke": "#cbd5e1",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {"url": "data/interstate_training_flows.csv"},
      "transform": [
        {"filter": "datum.Trainee_Count >= Min_Trainees"}
      ],
      "mark": {
        "type": "rule",
        "opacity": 0.65,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {"field": "Origin_Lon", "type": "quantitative"},
        "latitude": {"field": "Origin_Lat", "type": "quantitative"},
        "longitude2": {"field": "Dest_Lon"},
        "latitude2": {"field": "Dest_Lat"},
        "strokeWidth": {
          "field": "Trainee_Count",
          "type": "quantitative",
          "scale": {"domain": [800, 5500], "range": [1.5, 6.0]},
          "legend": {"title": "Annual Flow Volume"}
        },
        "color": {
          "field": "Dominant_Trade_Field",
          "type": "nominal",
          "scale": {"scheme": "category10"},
          "legend": {"title": "Primary Training Sector", "orient": "bottom-left"}
        },
        "tooltip": [
          {"field": "Origin_State", "type": "nominal", "title": "Origin"},
          {"field": "Dest_State", "type": "nominal", "title": "Destination"},
          {"field": "Trainee_Count", "type": "quantitative", "format": ",", "title": "Trainees Moving / Enrolled"},
          {"field": "Dominant_Trade_Field", "type": "nominal", "title": "Sector Focus"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "NSW", "lat": -33.8688, "lon": 151.2093},
          {"state": "VIC", "lat": -37.8136, "lon": 144.9631},
          {"state": "QLD", "lat": -27.4698, "lon": 153.0251},
          {"state": "WA",  "lat": -31.9505, "lon": 115.8605},
          {"state": "SA",  "lat": -34.9285, "lon": 138.6007},
          {"state": "TAS", "lat": -42.8821, "lon": 147.3272},
          {"state": "ACT", "lat": -35.2809, "lon": 149.1300},
          {"state": "NT",  "lat": -12.4634, "lon": 130.8456}
        ]
      },
      "mark": {
        "type": "circle",
        "size": 90,
        "color": "#0f172a",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    },
    {
      "data": {
        "values": [
          {"state": "NSW", "lat": -34.3, "lon": 151.8, "name": "Sydney"},
          {"state": "VIC", "lat": -38.3, "lon": 145.2, "name": "Melbourne"},
          {"state": "QLD", "lat": -27.1, "lon": 153.6, "name": "Brisbane"},
          {"state": "WA",  "lat": -32.5, "lon": 116.2, "name": "Perth"},
          {"state": "SA",  "lat": -35.3, "lon": 138.9, "name": "Adelaide"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "name", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {"stroke": null}
  }
}
