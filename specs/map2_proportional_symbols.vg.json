{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Metropolitan vs Regional Apprenticeship Training Centers",
    "subtitle": "Active apprentice volumes and trade focus across 28 official NCVER training hubs (2024). Source: NCVER",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 450,
  "params": [
    {
      "name": "Remoteness_Filter",
      "bind": {
        "input": "select",
        "options": ["All", "Major City", "Inner Regional", "Outer Regional", "Remote & Very Remote"],
        "labels": ["All Remoteness Areas", "Major Cities", "Inner Regional", "Outer Regional", "Remote & Very Remote"],
        "name": "Remoteness Area: "
      },
      "value": "All"
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [134, -28],
    "scale": 620
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/australia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/australia_regional_hubs.csv"
      },
      "transform": [
        {
          "filter": "Remoteness_Filter == 'All' || datum.Remoteness_Class == Remoteness_Filter"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "stroke": "#1e293b",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Active_Apprentices",
          "type": "quantitative",
          "title": "Active Apprentices",
          "scale": {
            "type": "sqrt",
            "domain": [800, 65000],
            "range": [35, 750]
          },
          "legend": {
            "orient": "bottom-right",
            "values": [5000, 25000, 60000]
          }
        },
        "color": {
          "field": "Trade_Share_Pct",
          "type": "quantitative",
          "title": "Trade Share (%)",
          "scale": {
            "type": "linear",
            "domain": [60, 90],
            "scheme": "oranges"
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 140
          }
        },
        "tooltip": [
          {"field": "Hub_Name", "type": "nominal", "title": "Training Hub"},
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Remoteness_Class", "type": "nominal", "title": "Remoteness Class"},
          {"field": "Active_Apprentices", "type": "quantitative", "format": ",", "title": "Active Apprentices"},
          {"field": "Trade_Share_Pct", "type": "quantitative", "format": ".1f", "title": "Trade Share (%)"},
          {"field": "Top_Trade_Field", "type": "nominal", "title": "Dominant Training Discipline"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 116.8, "lat": -19.5, "text": "Pilbara: 88.4% Heavy Mining Trades"},
          {"lon": 149.2, "lat": -20.2, "text": "Mackay: 84.2% Industrial Mechanical"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#9a3412"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {"stroke": null}
  }
}
