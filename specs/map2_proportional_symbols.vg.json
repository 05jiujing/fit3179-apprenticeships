{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "params": [
    {
      "name": "Remoteness_Filter",
      "bind": {
        "input": "select",
        "options": ["All", "Major City", "Inner Regional", "Outer Regional", "Remote & Very Remote"],
        "labels": ["All Remoteness Areas", "Major Cities", "Inner Regional", "Outer Regional", "Remote & Very Remote"],
        "name": "Remoteness Area: "
      },
      "value": "All"
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [134, -28],
    "scale": 650
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "data/australia_regional_hubs.csv"
      },
      "transform": [
        {
          "filter": "Remoteness_Filter == 'All' || datum.Remoteness_Class == Remoteness_Filter"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "stroke": "#1e293b",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Active_Apprentices",
          "type": "quantitative",
          "title": "Active Learners",
          "scale": {
            "type": "sqrt",
            "zero": true,
            "domain": [0, 65000],
            "range": [20, 750]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [10000, 50000],
            "format": ",d",
            "symbolFillColor": "#fdba74"
          }
        },
        "color": {
          "field": "Trade_Share_Pct",
          "type": "quantitative",
          "title": "Trade Share (%)",
          "scale": {
            "type": "linear",
            "zero": true,
            "domain": [0, 100],
            "scheme": "oranges"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 140
          }
        },
        "tooltip": [
          {"field": "Hub_Name", "type": "nominal", "title": "Training Hub"},
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Remoteness_Class", "type": "nominal", "title": "Remoteness Class"},
          {"field": "Active_Apprentices", "type": "quantitative", "format": ",", "title": "Active Apprentices"},
          {"field": "Trade_Share_Pct", "type": "quantitative", "format": ".1f", "title": "Trade Share (%)"},
          {"field": "Top_Trade_Field", "type": "nominal", "title": "Dominant Training Discipline"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 118.5, "lat": -21.0, "text": "Pilbara: 88.4% Trade Focus"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#9a3412"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"lon": 149.1, "lat": -21.1, "text": "Mackay: 84.2% Industrial Mechanical"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#9a3412"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600,
             "labelColor": "#475569", "titleColor": "#0f172a", "gridColor": "#e2e8f0", "domainColor": "#cbd5e1"},
    "legend": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600},
    "text": {"font": "Plus Jakarta Sans"}
  }
}
