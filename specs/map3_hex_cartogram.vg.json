{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/australia_hex_cartogram.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "M 0 -1 L 0.866 -0.5 L 0.866 0.5 L 0 1 L -0.866 0.5 L -0.866 -0.5 Z",
        "size": 5500,
        "filled": true,
        "stroke": "#ffffff",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "Grid_Col",
          "type": "quantitative",
          "scale": {"domain": [0.5, 4.5]},
          "axis": null
        },
        "y": {
          "field": "Grid_Row",
          "type": "quantitative",
          "scale": {"domain": [1.4, 6.6], "reverse": true},
          "axis": null
        },
        "color": {
          "field": "Change_Pct_2021_2025",
          "type": "quantitative",
          "title": "Change 2021–25 (%)",
          "scale": {
            "type": "linear",
            "zero": true,
            "domain": [-60, 0],
            "scheme": "reds",
            "reverse": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 160
          }
        },
        "tooltip": [
          {"field": "State_Name", "type": "nominal", "title": "State / Territory"},
          {"field": "State_Code", "type": "nominal", "title": "Code"},
          {"field": "Commencements_2021", "type": "quantitative", "format": ",", "title": "2021 Peak Commencements"},
          {"field": "Commencements_2025", "type": "quantitative", "format": ",", "title": "2025 Commencements"},
          {"field": "Change_Pct_2021_2025", "type": "quantitative", "format": ".1f", "title": "% Change"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 800,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#ffffff",
        "dy": -7
      },
      "encoding": {
        "x": {"field": "Grid_Col", "type": "quantitative"},
        "y": {"field": "Grid_Row", "type": "quantitative"},
        "text": {"field": "State_Code", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#f8fafc",
        "dy": 10
      },
      "encoding": {
        "x": {"field": "Grid_Col", "type": "quantitative"},
        "y": {"field": "Grid_Row", "type": "quantitative"},
        "text": {"field": "Change_Pct_2021_2025", "type": "quantitative", "format": ".1f"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans, sans-serif",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#475569",
      "titleColor": "#0f172a",
      "gridColor": "#e2e8f0",
      "domainColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Plus Jakarta Sans, sans-serif"}
  }
}
