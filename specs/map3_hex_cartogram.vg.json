{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Equal-Area Cartogram: Post-Subsidy Contraction (2021 vs 2025)",
    "subtitle": "Percentage change in quarterly commencements following wage subsidy expiry. Source: NCVER",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 450,
  "data": {
    "url": "data/australia_hex_cartogram.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "M 0 -1 L 0.866 -0.5 L 0.866 0.5 L 0 1 L -0.866 0.5 L -0.866 -0.5 Z",
        "size": 5200,
        "filled": true,
        "stroke": "#ffffff",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "Grid_Col",
          "type": "quantitative",
          "scale": {"domain": [0.4, 4.6]},
          "axis": null
        },
        "y": {
          "field": "Grid_Row",
          "type": "quantitative",
          "scale": {"domain": [1.2, 6.8], "reverse": true},
          "axis": null
        },
        "color": {
          "field": "Change_Pct_2021_2025",
          "type": "quantitative",
          "title": "Change 2021–25 (%)",
          "scale": {
            "type": "linear",
            "domain": [-60, -10],
            "scheme": "reds",
            "reverse": true
          },
          "legend": {
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 150
          }
        },
        "tooltip": [
          {"field": "State_Name", "type": "nominal", "title": "State / Territory"},
          {"field": "State_Code", "type": "nominal", "title": "Code"},
          {"field": "Commencements_2021", "type": "quantitative", "format": ",", "title": "2021 Peak Commencements"},
          {"field": "Commencements_2025", "type": "quantitative", "format": ",", "title": "2025 Commencements"},
          {"field": "Change_Pct_2021_2025", "type": "quantitative", "format": ".1f", "title": "% Change"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 800,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#ffffff",
        "dy": -7
      },
      "encoding": {
        "x": {"field": "Grid_Col", "type": "quantitative"},
        "y": {"field": "Grid_Row", "type": "quantitative"},
        "text": {"field": "State_Code", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#f8fafc",
        "dy": 10
      },
      "encoding": {
        "x": {"field": "Grid_Col", "type": "quantitative"},
        "y": {"field": "Grid_Row", "type": "quantitative"},
        "text": {"field": "Change_Pct_2021_2025", "type": "quantitative", "format": ".1f"}
      }
    },
    {
      "data": {
        "values": [
          {"col": 1.1, "row": 1.6, "text": "NT: Lowest post-subsidy drop (-11.0%)"},
          {"col": 1.0, "row": 5.8, "text": "Equal-area geometry balances small jurisdictions"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#64748b"
      },
      "encoding": {
        "x": {"field": "col", "type": "quantitative"},
        "y": {"field": "row", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {"stroke": null}
  }
}
