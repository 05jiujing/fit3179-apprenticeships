{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Vocational Gender Divide: Female vs Male Share Across Disciplines",
    "subtitle": "Cleveland dumbbell plot tracking gender disparity across active vocational vocations. Source: SA Skills Commission (2024)",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/sa_vocation_gender_breakdown.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "Vocation",
          "type": "nominal",
          "title": "Vocational Discipline",
          "sort": {"field": "Female_Share_Pct", "order": "ascending"},
          "axis": {"labelFontSize": 10}
        },
        "x": {
          "field": "Female_Share_Pct",
          "type": "quantitative",
          "title": "Share of Active Learners (%)",
          "scale": {"domain": [0, 100]}
        },
        "x2": {"field": "Male_Share_Pct"}
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#0284c7",
        "opacity": 0.95
      },
      "encoding": {
        "y": {
          "field": "Vocation",
          "type": "nominal",
          "sort": {"field": "Female_Share_Pct", "order": "ascending"}
        },
        "x": {"field": "Male_Share_Pct", "type": "quantitative"},
        "tooltip": [
          {"field": "Vocation", "type": "nominal", "title": "Vocation"},
          {"field": "Type", "type": "nominal", "title": "Type"},
          {"field": "Male_Share_Pct", "type": "quantitative", "format": ".1f", "title": "Male Share (%)"},
          {"field": "Male_Count", "type": "quantitative", "format": ",", "title": "Male Learners"}
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#0d9488",
        "opacity": 0.95
      },
      "encoding": {
        "y": {
          "field": "Vocation",
          "type": "nominal",
          "sort": {"field": "Female_Share_Pct", "order": "ascending"}
        },
        "x": {"field": "Female_Share_Pct", "type": "quantitative"},
        "tooltip": [
          {"field": "Vocation", "type": "nominal", "title": "Vocation"},
          {"field": "Type", "type": "nominal", "title": "Type"},
          {"field": "Female_Share_Pct", "type": "quantitative", "format": ".1f", "title": "Female Share (%)"},
          {"field": "Female_Count", "type": "quantitative", "format": ",", "title": "Female Learners"},
          {"field": "Total_Learners", "type": "quantitative", "format": ",", "title": "Total Contracts"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"vocation": "Plumbing And/Or Gasfitting", "x": 10.0, "text": "Plumbing: 1.8% Female"},
          {"vocation": "Child Care Aide", "x": 80.0, "text": "Child Care: 96.3% Female"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10.5,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f766e"
      },
      "encoding": {
        "y": {"field": "vocation", "type": "nominal"},
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
