{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Gender Divide in Australian Vocational Trades: 2014 vs 2024",
    "subtitle": "Cleveland dumbbell plot tracking female representation shifts across 9 sectors. Source: NCVER",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/ncver_demographics_diversity.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "Trade_Field",
          "type": "nominal",
          "title": "Vocational Field",
          "sort": {"field": "Female_Share_2024_Pct", "order": "ascending"}
        },
        "x": {
          "field": "Female_Share_2014_Pct",
          "type": "quantitative",
          "title": "Female Representation (%)",
          "scale": {"domain": [0, 95]}
        },
        "x2": {"field": "Female_Share_2024_Pct"}
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#94a3b8",
        "opacity": 0.95
      },
      "encoding": {
        "y": {"field": "Trade_Field", "type": "nominal", "sort": {"field": "Female_Share_2024_Pct", "order": "ascending"}},
        "x": {"field": "Female_Share_2014_Pct", "type": "quantitative"},
        "tooltip": [
          {"field": "Trade_Field", "type": "nominal", "title": "Field"},
          {"field": "Female_Share_2014_Pct", "type": "quantitative", "format": ".1f", "title": "2014 Female Share (%)"},
          {"field": "Classification", "type": "nominal", "title": "Type"}
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 130,
        "color": "#0d9488",
        "opacity": 0.95
      },
      "encoding": {
        "y": {"field": "Trade_Field", "type": "nominal", "sort": {"field": "Female_Share_2024_Pct", "order": "ascending"}},
        "x": {"field": "Female_Share_2024_Pct", "type": "quantitative"},
        "tooltip": [
          {"field": "Trade_Field", "type": "nominal", "title": "Field"},
          {"field": "Female_Share_2024_Pct", "type": "quantitative", "format": ".1f", "title": "2024 Female Share (%)"},
          {"field": "Net_10Yr_Change_Pct", "type": "quantitative", "format": "+.1f", "title": "10-Year Change (%)"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"field": "Construction Trades", "x": 6.0, "text": "Construction: Only 3.8% female despite 10 years of campaigns"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f766e"
      },
      "encoding": {
        "y": {"field": "field", "type": "nominal"},
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
