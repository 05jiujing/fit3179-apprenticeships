{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/sa_vocation_gender_breakdown.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "Vocation",
          "type": "nominal",
          "title": "Vocational Discipline",
          "sort": {"field": "Female_Share_Pct", "order": "ascending"},
          "axis": {"labelFontSize": 10.5}
        },
        "x": {
          "field": "Female_Share_Pct",
          "type": "quantitative",
          "title": "Share of Active Learners (%)",
          "scale": {"domain": [0, 100]}
        },
        "x2": {"field": "Male_Share_Pct"}
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#0284c7",
        "opacity": 0.95
      },
      "encoding": {
        "y": {
          "field": "Vocation",
          "type": "nominal",
          "sort": {"field": "Female_Share_Pct", "order": "ascending"}
        },
        "x": {"field": "Male_Share_Pct", "type": "quantitative"},
        "tooltip": [
          {"field": "Vocation", "type": "nominal", "title": "Vocation"},
          {"field": "Type", "type": "nominal", "title": "Type"},
          {"field": "Male_Share_Pct", "type": "quantitative", "format": ".1f", "title": "Male Share (%)"},
          {"field": "Male_Count", "type": "quantitative", "format": ",", "title": "Male Learners"}
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#0d9488",
        "opacity": 0.95
      },
      "encoding": {
        "y": {
          "field": "Vocation",
          "type": "nominal",
          "sort": {"field": "Female_Share_Pct", "order": "ascending"}
        },
        "x": {"field": "Female_Share_Pct", "type": "quantitative"},
        "tooltip": [
          {"field": "Vocation", "type": "nominal", "title": "Vocation"},
          {"field": "Type", "type": "nominal", "title": "Type"},
          {"field": "Female_Share_Pct", "type": "quantitative", "format": ".1f", "title": "Female Share (%)"},
          {"field": "Female_Count", "type": "quantitative", "format": ",", "title": "Female Learners"},
          {"field": "Total_Learners", "type": "quantitative", "format": ",", "title": "Total Contracts"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"vocation": "Plumbing And/Or Gasfitting", "x": 1.8, "text": "Plumbing: 1.8% female"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#0f766e"
      },
      "encoding": {
        "y": {"field": "vocation", "type": "nominal"},
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"vocation": "Child Care Aide", "x": 96.3, "text": "Child Care Aide: 96.3% female"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#0f766e"
      },
      "encoding": {
        "y": {"field": "vocation", "type": "nominal"},
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#475569",
      "titleColor": "#0f172a",
      "gridColor": "#e2e8f0",
      "domainColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Plus Jakarta Sans"}
  }
}
