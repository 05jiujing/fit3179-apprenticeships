{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Quarterly Pipeline Momentum: Net Intake vs Attrition (2004–2024)",
    "subtitle": "Diverging area showing net pipeline change (Commencements minus Attrition/Completions). Source: NCVER",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/ncver_timeseries_2000_2024.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.5,
        "line": {"color": "#0284c7", "width": 1.5}
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "nominal",
          "title": "Year & Quarter",
          "axis": {
            "labelAngle": -45,
            "values": ["2004-Q1", "2007-Q1", "2010-Q1", "2013-Q1", "2016-Q1", "2019-Q1", "2022-Q1", "2024-Q4"]
          }
        },
        "y": {
          "field": "Net_Quarterly_Change",
          "type": "quantitative",
          "title": "Net Quarterly Additions / Deficit"
        },
        "color": {
          "condition": {
            "test": "datum.Net_Quarterly_Change >= 0",
            "value": "#0284c7"
          },
          "value": "#ef4444"
        }
      }
    },
    {
      "mark": {"type": "rule", "color": "#64748b", "strokeDash": [4, 4]},
      "encoding": {
        "y": {"datum": 0}
      }
    },
    {
      "data": {
        "values": [
          {"period": "2021-Q1", "val": 12500, "text": "2021: BAC Wage Subsidy Inflow Peak"},
          {"period": "2014-Q3", "val": -4500, "text": "2014: Post-Reform Deficit"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "dy": -10
      },
      "encoding": {
        "x": {"field": "period", "type": "nominal"},
        "y": {"field": "val", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
