{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Quarterly Pipeline Momentum: Net Intake vs Loss (2016–2025)",
    "subtitle": "Diverging area showing net pipeline change (Commencements minus Exits). Source: NCVER",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/ncver_timeseries_2000_2024.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.55,
        "line": {"color": "#0284c7", "width": 1.5}
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "nominal",
          "title": "Year & Quarter",
          "axis": {
            "labelAngle": 0,
            "values": ["2016-Q1", "2018-Q1", "2020-Q1", "2022-Q1", "2024-Q1", "2025-Q4"]
          }
        },
        "y": {
          "field": "Net_Quarterly_Change",
          "type": "quantitative",
          "title": "Net Quarterly Additions / Deficit"
        },
        "color": {
          "condition": {
            "test": "datum.Net_Quarterly_Change >= 0",
            "value": "#0284c7"
          },
          "value": "#ef4444"
        },
        "tooltip": [
          {"field": "Period", "type": "nominal", "title": "Quarter"},
          {"field": "Commencements", "type": "quantitative", "format": ",", "title": "Commencements"},
          {"field": "Completions", "type": "quantitative", "format": ",", "title": "Completions"},
          {"field": "Cancellations_Withdrawals", "type": "quantitative", "format": ",", "title": "Cancellations"},
          {"field": "Net_Quarterly_Change", "type": "quantitative", "format": "+,", "title": "Net Change"}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#64748b", "strokeDash": [4, 4]},
      "encoding": {
        "y": {"datum": 0}
      }
    },
    {
      "data": {
        "values": [
          {"period": "2020-Q4", "val": 28810, "text": "2020-Q4: +28.8k Subsidy Boom Peak"},
          {"period": "2025-Q4", "val": -19820, "text": "2025-Q4: -19.8k Post-Subsidy Deficit"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "dy": -10
      },
      "encoding": {
        "x": {"field": "period", "type": "nominal"},
        "y": {"field": "val", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
