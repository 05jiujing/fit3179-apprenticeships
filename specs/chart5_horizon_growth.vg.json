{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/ncver_timeseries_2000_2024.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.55,
        "line": {"color": "#0284c7", "width": 1.5}
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "nominal",
          "title": "Year & Quarter",
          "axis": {
            "labelAngle": 0,
            "values": ["2016-Q1", "2018-Q1", "2020-Q1", "2022-Q1", "2024-Q1", "2025-Q4"]
          }
        },
        "y": {
          "field": "Net_Quarterly_Change",
          "type": "quantitative",
          "title": "Net Quarterly Additions / Deficit"
        },
        "color": {
          "condition": {
            "test": "datum.Net_Quarterly_Change >= 0",
            "value": "#0284c7"
          },
          "value": "#ef4444"
        },
        "tooltip": [
          {"field": "Period", "type": "nominal", "title": "Quarter"},
          {"field": "Commencements", "type": "quantitative", "format": ",", "title": "Commencements"},
          {"field": "Completions", "type": "quantitative", "format": ",", "title": "Completions"},
          {"field": "Cancellations_Withdrawals", "type": "quantitative", "format": ",", "title": "Cancellations"},
          {"field": "Net_Quarterly_Change", "type": "quantitative", "format": "+,", "title": "Net Change"}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#64748b", "strokeDash": [4, 4]},
      "encoding": {
        "y": {"datum": 0}
      }
    },
    {
      "data": {
        "values": [
          {"period": "2022-Q1", "val": 43945, "text": "2022-Q1: +43,945"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "align": "right",
        "dx": -8,
        "dy": -10
      },
      "encoding": {
        "x": {"field": "period", "type": "nominal"},
        "y": {"field": "val", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"period": "2022-Q4", "val": -30870, "text": "2022-Q4: −30,870"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "align": "left",
        "dx": 8,
        "dy": 10
      },
      "encoding": {
        "x": {"field": "period", "type": "nominal"},
        "y": {"field": "val", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600,
             "labelColor": "#475569", "titleColor": "#0f172a", "gridColor": "#e2e8f0", "domainColor": "#cbd5e1"},
    "legend": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600},
    "text": {"font": "Plus Jakarta Sans"}
  }
}
