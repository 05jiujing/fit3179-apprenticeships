{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/apprentice_wage_distributions.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 28,
        "color": "#0284c7",
        "median": {"color": "#ffffff", "size": 2}
      },
      "encoding": {
        "x": {
          "field": "Sector",
          "type": "nominal",
          "title": "Trade & Traineeship Award Sector",
          "axis": {
            "labelAngle": -25,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "Weekly_Award_Wage_AUD",
          "type": "quantitative",
          "title": "Weekly Award Wage (AUD)",
          "scale": {"zero": true, "domain": [0, 1150]}
        },
        "tooltip": [
          {"field": "Sector", "type": "nominal", "title": "Award Sector"},
          {"field": "Apprenticeship_Stage", "type": "nominal", "title": "Stage"},
          {"field": "Weekly_Award_Wage_AUD", "type": "quantitative", "format": "$,.2f", "title": "Weekly Wage (AUD)"},
          {"field": "Wage_Deficit_To_Minimum", "type": "quantitative", "format": "+$,.2f", "title": "Difference to Adult Minimum"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#dc2626",
        "strokeWidth": 2,
        "strokeDash": [6, 4]
      },
      "encoding": {
        "y": {"datum": 915.9}
      }
    },
    {
      "data": {
        "values": [
          {"sector": "Care & Community Traineeship", "text": "Adult min. wage $915.90/wk"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 0,
        "dy": -8,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#dc2626"
      },
      "encoding": {
        "x": {"field": "sector", "type": "nominal"},
        "y": {"datum": 915.9},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans, sans-serif",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#475569",
      "titleColor": "#0f172a",
      "gridColor": "#e2e8f0",
      "domainColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Plus Jakarta Sans, sans-serif"}
  }
}
