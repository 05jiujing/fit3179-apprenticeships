{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Apprentice Award Wages vs National Adult Minimum Wage",
    "subtitle": "Weekly statutory modern award wage progression (Stage 1 to Stage 4). Source: Fair Work Commission (2024)",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/apprentice_wage_distributions.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 28,
        "color": "#0284c7",
        "median": {"color": "#ffffff", "size": 2}
      },
      "encoding": {
        "x": {
          "field": "Sector",
          "type": "nominal",
          "title": "Trade & Traineeship Award Sector",
          "axis": {
            "labelAngle": -25,
            "labelFontSize": 10
          }
        },
        "y": {
          "field": "Weekly_Award_Wage_AUD",
          "type": "quantitative",
          "title": "Weekly Award Wage (AUD)",
          "scale": {"domain": [400, 1150]}
        },
        "tooltip": [
          {"field": "Sector", "type": "nominal", "title": "Award Sector"},
          {"field": "Apprenticeship_Stage", "type": "nominal", "title": "Stage"},
          {"field": "Weekly_Award_Wage_AUD", "type": "quantitative", "format": "$,.2f", "title": "Weekly Wage (AUD)"},
          {"field": "Wage_Deficit_To_Minimum", "type": "quantitative", "format": "+$,.2f", "title": "Difference to Adult Minimum"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#dc2626",
        "strokeWidth": 2,
        "strokeDash": [6, 4]
      },
      "encoding": {
        "y": {"datum": 915.9}
      }
    },
    {
      "data": {
        "values": [
          {"sector": "Automotive Mechanical", "wage": 945, "text": "Adult Minimum Wage ($915.90/wk)"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#dc2626"
      },
      "encoding": {
        "x": {"field": "sector", "type": "nominal"},
        "y": {"field": "wage", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
