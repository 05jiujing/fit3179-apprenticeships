{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of Australian Apprenticeships by Industry Division (ANZSIC)",
  "height": 500,
  "padding": 5,
  "autosize": {"type": "fit", "contains": "padding"},
  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 1100",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 1100"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "root_node",
      "values": [
        {"id": "ROOT", "parent": null, "Active_Apprentices": 0, "Industry_Name": "All Industries"}
      ]
    },
    {
      "name": "raw",
      "url": "data/ncver_industry_trades.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Active_Apprentices": "number",
          "Trade_Share_Pct": "number",
          "Female_Share_Pct": "number",
          "Median_Weekly_Training_Wage": "number"
        }
      },
      "transform": [
        {"type": "formula", "expr": "datum.Industry_Code", "as": "id"},
        {"type": "formula", "expr": "'ROOT'", "as": "parent"}
      ]
    },
    {
      "name": "industries",
      "source": ["root_node", "raw"],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "Active_Apprentices",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "squarify",
          "ratio": 1.6,
          "size": [{"signal": "width"}, {"signal": "height"}]
        },
        {
          "type": "filter",
          "expr": "datum.id !== 'ROOT'"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "linear",
      "domain": [0, 100],
      "range": ["#e0f2fe", "#0369a1"]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "industries"},
      "encode": {
        "enter": {
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 2}
        },
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": [
            {"test": "datum.Trade_Share_Pct !== null", "scale": "color", "field": "Trade_Share_Pct"},
            {"value": "#0284c7"}
          ],
          "tooltip": {
            "signal": "{'Industry': datum.Industry_Name, 'Active Apprentices': format(datum.Active_Apprentices, ','), 'Trade Share (%)': format(datum.Trade_Share_Pct, '.1f') + '%', 'Female Share (%)': format(datum.Female_Share_Pct, '.1f') + '%'}"
          }
        },
        "hover": {
          "fillOpacity": {"value": 0.85}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "industries"},
      "interactive": false,
      "encode": {
        "enter": {
          "font": {"value": "Plus Jakarta Sans"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": 600},
          "fill": [
            {"test": "datum.Trade_Share_Pct > 50", "value": "#ffffff"},
            {"value": "#0f172a"}
          ],
          "baseline": {"value": "middle"},
          "align": {"value": "center"}
        },
        "update": {
          "x": {"signal": "0.5 * (datum.x0 + datum.x1)"},
          "y": {"signal": "0.5 * (datum.y0 + datum.y1)"},
          "text": [
            {"test": "(datum.x1 - datum.x0) > 65 && (datum.y1 - datum.y0) > 30", "field": "Industry_Name"},
            {"value": ""}
          ],
          "limit": {"signal": "max(20, (datum.x1 - datum.x0) - 10)"},
          "fillOpacity": [
            {"test": "(datum.x1 - datum.x0) > 65 && (datum.y1 - datum.y0) > 30", "value": 1},
            {"value": 0}
          ]
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Trade Share (%)",
      "orient": "bottom",
      "direction": "horizontal",
      "gradientLength": 200
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#475569",
      "titleColor": "#0f172a",
      "gridColor": "#e2e8f0",
      "domainColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Plus Jakarta Sans"}
  }
}
