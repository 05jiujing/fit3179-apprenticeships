{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of Australian Apprenticeships by Industry Division (ANZSIC)",
  "width": 850,
  "height": 450,
  "padding": 5,
  "autosize": "fit",
  "title": {
    "text": "Apprentice Distribution Across Australian Industry Divisions (2024)",
    "subtitle": "Tile area encodes total active apprentice population; color saturation encodes Trade Share (%). Source: NCVER",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "font": "Plus Jakarta Sans, sans-serif",
    "anchor": "start"
  },
  "data": [
    {
      "name": "root_node",
      "values": [
        {"id": "ROOT", "parent": null, "Active_Apprentices": 0, "Industry_Name": "All Industries"}
      ]
    },
    {
      "name": "raw",
      "url": "data/ncver_industry_trades.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Active_Apprentices": "number",
          "Trade_Share_Pct": "number",
          "Female_Share_Pct": "number",
          "Median_Weekly_Training_Wage": "number"
        }
      },
      "transform": [
        {"type": "formula", "expr": "datum.Industry_Code", "as": "id"},
        {"type": "formula", "expr": "'ROOT'", "as": "parent"}
      ]
    },
    {
      "name": "industries",
      "source": ["root_node", "raw"],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "Active_Apprentices",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "squarify",
          "ratio": 1.6,
          "size": [{"signal": "width"}, {"signal": "height"}]
        },
        {
          "type": "filter",
          "expr": "datum.id !== 'ROOT'"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "linear",
      "domain": [0, 100],
      "range": ["#e0f2fe", "#0369a1"]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "industries"},
      "encode": {
        "enter": {
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 2}
        },
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": [
            {"test": "datum.Trade_Share_Pct !== null", "scale": "color", "field": "Trade_Share_Pct"},
            {"value": "#0284c7"}
          ],
          "tooltip": {
            "signal": "{'Industry': datum.Industry_Name, 'Active Apprentices': format(datum.Active_Apprentices, ','), 'Trade Share (%)': format(datum.Trade_Share_Pct, '.1f') + '%', 'Female Share (%)': format(datum.Female_Share_Pct, '.1f') + '%'}"
          }
        },
        "hover": {
          "fillOpacity": {"value": 0.85}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "industries"},
      "interactive": false,
      "encode": {
        "enter": {
          "font": {"value": "Plus Jakarta Sans, sans-serif"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": 700},
          "fill": [
            {"test": "datum.Trade_Share_Pct > 50", "value": "#ffffff"},
            {"value": "#0f172a"}
          ],
          "baseline": {"value": "middle"},
          "align": {"value": "center"}
        },
        "update": {
          "x": {"signal": "0.5 * (datum.x0 + datum.x1)"},
          "y": {"signal": "0.5 * (datum.y0 + datum.y1)"},
          "text": [
            {"test": "(datum.x1 - datum.x0) > 120 && (datum.y1 - datum.y0) > 45", "field": "Industry_Name"},
            {"value": ""}
          ],
          "fillOpacity": [
            {"test": "(datum.x1 - datum.x0) > 120 && (datum.y1 - datum.y0) > 45", "value": 1},
            {"value": 0}
          ]
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Trade Share (%)",
      "orient": "bottom-right",
      "direction": "horizontal",
      "gradientLength": 140,
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "labelFont": "Plus Jakarta Sans, sans-serif"
    }
  ]
}
