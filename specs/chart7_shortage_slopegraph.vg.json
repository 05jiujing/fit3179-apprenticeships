{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 Trade Occupations: The Post-Boom Shift (2021 vs 2025)",
    "subtitle": "Slopegraph comparing quarterly commencements during the subsidy peak vs post-subsidy reality. Source: NCVER",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/ncver_top10_trades.csv"
  },
  "transform": [
    {
      "fold": ["Commencements_2021", "Commencements_2025"],
      "as": ["Year_Key", "Commencements"]
    },
    {
      "calculate": "datum.Year_Key == 'Commencements_2021' ? '2021 (Subsidy Peak)' : '2025 (Post-Subsidy)'",
      "as": "Year_Label"
    },
    {
      "calculate": "split(datum.Occupation, ' - ')[1]",
      "as": "Short_Title"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.4,
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "Year_Label",
          "type": "nominal",
          "title": null,
          "scale": {"padding": 0.35}
        },
        "y": {
          "field": "Commencements",
          "type": "quantitative",
          "title": "Quarterly Commencements",
          "scale": {"domain": [200, 3200]}
        },
        "detail": {"field": "Occupation"},
        "color": {
          "field": "Short_Title",
          "type": "nominal",
          "scale": {"scheme": "tableau10"},
          "legend": {
            "title": "Trade Discipline",
            "orient": "bottom",
            "columns": 2,
            "labelFontSize": 10,
            "titleFontSize": 11
          }
        }
      }
    },
    {
      "mark": {"type": "circle", "size": 65, "opacity": 0.95},
      "encoding": {
        "x": {"field": "Year_Label", "type": "nominal"},
        "y": {"field": "Commencements", "type": "quantitative"},
        "color": {"field": "Short_Title", "type": "nominal"},
        "tooltip": [
          {"field": "Occupation", "type": "nominal", "title": "Occupation"},
          {"field": "Year_Label", "type": "nominal", "title": "Period"},
          {"field": "Commencements", "type": "quantitative", "format": ",", "title": "Commencements"},
          {"field": "Change_Pct_2021_2025", "type": "quantitative", "format": "+.1f", "title": "4-Yr Change (%)"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"year": "2021 (Subsidy Peak)", "val": 2970, "text": "Carpenters Peak: 2,970"},
          {"year": "2025 (Post-Subsidy)", "val": 2675, "text": "Electricians Lead: 2,675"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "dy": -12
      },
      "encoding": {
        "x": {"field": "year", "type": "nominal"},
        "y": {"field": "val", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
