{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "padding": {"top": 10, "left": 10, "bottom": 10, "right": 140},
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/ncver_top10_trades.csv"
  },
  "transform": [
    {
      "fold": ["Commencements_2021", "Commencements_2025"],
      "as": ["Year_Key", "Commencements"]
    },
    {
      "calculate": "datum.Year_Key == 'Commencements_2021' ? '2021' : '2025'",
      "as": "Year_Label"
    },
    {
      "calculate": "datum.Occupation == '3411 - Electricians' ? 'Electricians' : (datum.Occupation == '3312 - Carpenters and Joiners' ? 'Carpenters' : 'Other')",
      "as": "Highlight"
    },
    {
      "calculate": "split(datum.Occupation, ' - ')[1]",
      "as": "Short_Title"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "linear"
      },
      "encoding": {
        "x": {
          "field": "Year_Label",
          "type": "nominal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": 600
          },
          "scale": {"padding": 0.25}
        },
        "y": {
          "field": "Commencements",
          "type": "quantitative",
          "title": "Quarterly Commencements",
          "scale": {"zero": true, "domain": [0, 3200]}
        },
        "detail": {"field": "Occupation"},
        "color": {
          "field": "Highlight",
          "type": "nominal",
          "scale": {
            "domain": ["Carpenters", "Electricians", "Other"],
            "range": ["#e11d48", "#0284c7", "#94a3b8"]
          },
          "legend": null
        },
        "strokeWidth": {
          "field": "Highlight",
          "type": "nominal",
          "sort": ["Carpenters", "Electricians", "Other"],
          "scale": {
            "domain": ["Carpenters", "Electricians", "Other"],
            "range": [3.2, 3.2, 1.6]
          },
          "legend": null
        },
        "opacity": {
          "field": "Highlight",
          "type": "nominal",
          "sort": ["Carpenters", "Electricians", "Other"],
          "scale": {
            "domain": ["Carpenters", "Electricians", "Other"],
            "range": [1, 1, 0.55]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {"type": "circle", "size": 75, "opacity": 0.95},
      "encoding": {
        "x": {"field": "Year_Label", "type": "nominal"},
        "y": {"field": "Commencements", "type": "quantitative"},
        "color": {
          "field": "Highlight",
          "type": "nominal",
          "scale": {
            "domain": ["Carpenters", "Electricians", "Other"],
            "range": ["#e11d48", "#0284c7", "#94a3b8"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "Occupation", "type": "nominal", "title": "Occupation"},
          {"field": "Year_Label", "type": "nominal", "title": "Period"},
          {"field": "Commencements", "type": "quantitative", "format": ",", "title": "Commencements"},
          {"field": "Change_Pct_2021_2025", "type": "quantitative", "format": "+.1f", "title": "4-Yr Change (%)"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.Year_Key == 'Commencements_2025' && datum.Highlight != 'Other'"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {"field": "Year_Label", "type": "nominal"},
        "y": {"field": "Commencements", "type": "quantitative"},
        "text": {"field": "Short_Title", "type": "nominal"},
        "color": {
          "field": "Highlight",
          "type": "nominal",
          "scale": {
            "domain": ["Carpenters", "Electricians", "Other"],
            "range": ["#e11d48", "#0284c7", "#94a3b8"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {"year": "2021", "val": 2970, "text": "Carpenters Peak: 2,970"},
          {"year": "2025", "val": 2675, "text": "Electricians Lead: 2,675"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a",
        "dy": -12
      },
      "encoding": {
        "x": {"field": "year", "type": "nominal"},
        "y": {"field": "val", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"year": "2025", "val": 1865, "text": "Other trades in grey"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 16,
        "fontSize": 11,
        "fontStyle": "italic",
        "fill": "#94a3b8"
      },
      "encoding": {
        "x": {"field": "year", "type": "nominal"},
        "y": {"field": "val", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans, sans-serif",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#475569",
      "titleColor": "#0f172a",
      "gridColor": "#e2e8f0",
      "domainColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Plus Jakarta Sans, sans-serif"}
  }
}
