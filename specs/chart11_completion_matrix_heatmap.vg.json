{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/completion_matrix_data.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Vocational_Sector",
          "type": "nominal",
          "title": "Vocational Discipline",
          "axis": {
            "labelAngle": -35,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "y": {
          "field": "AQF_Level",
          "type": "nominal",
          "title": "AQF Level",
          "sort": ["Certificate II", "Certificate III (Trade)", "Certificate IV", "Diploma & Above"],
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "color": {
          "field": "Cohort_Completion_Rate_Pct",
          "type": "quantitative",
          "title": "Completion Rate (%)",
          "scale": {
            "type": "linear",
            "domain": [0, 100],
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {"field": "Vocational_Sector", "type": "nominal", "title": "Sector"},
          {"field": "AQF_Level", "type": "nominal", "title": "Qualification Level"},
          {"field": "Cohort_Completion_Rate_Pct", "type": "quantitative", "format": ".1f", "title": "Completion Rate (%)"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif"
      },
      "encoding": {
        "x": {"field": "Vocational_Sector", "type": "nominal"},
        "y": {
          "field": "AQF_Level",
          "type": "nominal",
          "sort": ["Certificate II", "Certificate III (Trade)", "Certificate IV", "Diploma & Above"]
        },
        "text": {"field": "Cohort_Completion_Rate_Pct", "type": "quantitative", "format": ".1f"},
        "color": {
          "condition": {
            "test": "datum.Cohort_Completion_Rate_Pct > 55",
            "value": "#ffffff"
          },
          "value": "#0f172a"
        }
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#475569",
      "titleColor": "#0f172a",
      "gridColor": "#e2e8f0",
      "domainColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Plus Jakarta Sans"}
  }
}
