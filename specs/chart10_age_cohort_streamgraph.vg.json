{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Aging Apprentice: Demographic Transformation (2014–2024)",
    "subtitle": "Streamgraph illustrating the shift from teenage school leavers to adult apprentices (25+). Source: NCVER",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/age_cohort_timeseries.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.88
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Calendar Year",
          "axis": {"labelAngle": 0}
        },
        "y": {
          "field": "Percentage",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "Age_Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Under 19 (School Leavers)",
              "20 to 24 Years",
              "25 to 44 Years (Adult)",
              "45+ Years (Career Changers)"
            ],
            "range": ["#38bdf8", "#818cf8", "#f59e0b", "#f43f5e"]
          },
          "legend": {
            "title": "Age Demographic",
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 10,
            "titleFontSize": 11
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Age_Group", "type": "nominal", "title": "Cohort"},
          {"field": "Percentage", "type": "quantitative", "format": ".1f", "title": "Share of Intake (%)"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"year": "2014", "y_pos": 45, "text": "2014: Youth Leavers 38.4%"},
          {"year": "2024", "y_pos": 45, "text": "2024: Adult Learners 36.2%"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "y_pos", "type": "quantitative", "axis": null},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif"
    }
  }
}
