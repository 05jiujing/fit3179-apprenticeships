{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/age_cohort_timeseries.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.88
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Calendar Year",
          "axis": {"labelAngle": 0}
        },
        "y": {
          "field": "Percentage",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "Age_Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Under 19 (School Leavers)",
              "20 to 24 Years",
              "25 to 44 Years (Adult)",
              "45+ Years (Career Changers)"
            ],
            "range": ["#38bdf8", "#818cf8", "#f59e0b", "#f43f5e"]
          },
          "legend": {
            "title": "Age Demographic",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Age_Group", "type": "nominal", "title": "Cohort"},
          {"field": "Percentage", "type": "quantitative", "format": ".1f", "title": "Share of Intake (%)"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"year": "2014", "y_pos": 42, "text": "2014: Youth Leavers 38.4%"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "y_pos", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"year": "2024", "y_pos": 42, "text": "2024: Adult Learners 36.2%"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "y_pos", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#475569",
      "titleColor": "#0f172a",
      "gridColor": "#e2e8f0",
      "domainColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {"font": "Plus Jakarta Sans"}
  }
}
