{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The 20-Year Apprenticeship Trajectory: Commencements vs Completions (2004–2024)",
    "subtitle": "Connected scatterplot tracking quarterly vocational throughput across 6 policy eras. Source: NCVER",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/05jiujing/fit3179-apprenticeships/main/data/ncver_timeseries_2000_2024.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.2,
        "opacity": 0.75,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Quarterly_Commencements",
          "type": "quantitative",
          "title": "Quarterly Commencements (New Enrolments)",
          "scale": {"zero": false}
        },
        "y": {
          "field": "Quarterly_Completions",
          "type": "quantitative",
          "title": "Quarterly Completions (Graduates)",
          "scale": {"zero": false}
        },
        "order": {"field": "Period"},
        "color": {
          "field": "Policy_Era",
          "type": "nominal",
          "scale": {
            "domain": [
              "Pre-GFC Traineeship Expansion",
              "Mining Boom & Stimulus",
              "Traineeship All-Time Peak",
              "Post-Reform Incentive Contraction",
              "Structural Trough",
              "Pre-Pandemic Plateau",
              "COVID-19 BAC Wage Subsidy Launch",
              "BAC 50% Subsidy Boom",
              "All-Time Apprentice Surge",
              "Subsidy Cliff & Transition",
              "Australian Skills Guarantee Era"
            ],
            "scheme": "tableau20"
          },
          "legend": {"title": "Historical Policy Era", "orient": "bottom", "columns": 2}
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 65,
        "opacity": 0.9
      },
      "encoding": {
        "x": {"field": "Quarterly_Commencements", "type": "quantitative"},
        "y": {"field": "Quarterly_Completions", "type": "quantitative"},
        "color": {"field": "Policy_Era", "type": "nominal"},
        "tooltip": [
          {"field": "Period", "type": "nominal", "title": "Quarter"},
          {"field": "Quarterly_Commencements", "type": "quantitative", "format": ",", "title": "Commencements"},
          {"field": "Quarterly_Completions", "type": "quantitative", "format": ",", "title": "Completions"},
          {"field": "Total_In_Training", "type": "quantitative", "format": ",", "title": "Total In Training"},
          {"field": "Policy_Era", "type": "nominal", "title": "Policy Context"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "commence": 29800,
            "comp": 8400,
            "text": "2022: Massive COVID BAC Surge (~30k/qtr)"
          },
          {
            "commence": 8500,
            "comp": 5800,
            "text": "2016: Post-Reform Trough"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -8,
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {"field": "commence", "type": "quantitative"},
        "y": {"field": "comp", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
