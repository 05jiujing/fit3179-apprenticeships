{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/ncver_timeseries_2000_2024.csv"
  },
  "transform": [
    {
      "calculate": "datum.Year <= 2019 ? 'Before COVID (2016–19)' : (datum.Year <= 2022 ? 'Wage subsidy (2020–22)' : 'After the subsidy (2023–25)')",
      "as": "Policy_Era"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.2,
        "opacity": 0.75,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Commencements",
          "type": "quantitative",
          "title": "Quarterly Commencements (New Enrolments)",
          "scale": {"zero": false}
        },
        "y": {
          "field": "Completions",
          "type": "quantitative",
          "title": "Quarterly Completions (Graduates)",
          "scale": {"zero": false}
        },
        "order": {"field": "Period"},
        "color": {
          "field": "Policy_Era",
          "type": "nominal",
          "scale": {
            "domain": [
              "Before COVID (2016–19)",
              "Wage subsidy (2020–22)",
              "After the subsidy (2023–25)"
            ],
            "range": ["#64748b", "#0284c7", "#ef4444"]
          },
          "legend": {
            "title": "Policy Era",
            "orient": "bottom",
            "direction": "horizontal"
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 65,
        "opacity": 0.9
      },
      "encoding": {
        "x": {"field": "Commencements", "type": "quantitative"},
        "y": {"field": "Completions", "type": "quantitative"},
        "color": {"field": "Policy_Era", "type": "nominal"},
        "tooltip": [
          {"field": "Period", "type": "nominal", "title": "Quarter"},
          {"field": "Commencements", "type": "quantitative", "format": ",", "title": "Commencements"},
          {"field": "Completions", "type": "quantitative", "format": ",", "title": "Completions"},
          {"field": "In_Training", "type": "quantitative", "format": ",", "title": "In Training"},
          {"field": "Policy_Era", "type": "nominal", "title": "Era"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "commence": 99410,
            "comp": 22875,
            "text": "2022-Q1: 99,410 commencements"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -8,
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {"field": "commence", "type": "quantitative"},
        "y": {"field": "comp", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {
            "commence": 22295,
            "comp": 14825,
            "text": "2020-Q2: lockdown trough"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -8,
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {"field": "commence", "type": "quantitative"},
        "y": {"field": "comp", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600,
             "labelColor": "#475569", "titleColor": "#0f172a", "gridColor": "#e2e8f0", "domainColor": "#cbd5e1"},
    "legend": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600},
    "text": {"font": "Plus Jakarta Sans"}
  }
}
