{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Apprenticeship Trajectory: Commencements vs Completions (2016–2025)",
    "subtitle": "Connected scatterplot tracking quarterly vocational throughput across policy eras. Source: NCVER",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "font": "Plus Jakarta Sans, sans-serif"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/ncver_timeseries_2000_2024.csv"
  },
  "transform": [
    {
      "calculate": "datum.Year <= 2019 ? 'Pre-Pandemic Baseline (2016-19)' : (datum.Year <= 2022 ? 'COVID Wage Subsidy Boom (2020-22)' : 'Post-Subsidy Contraction (2023-25)')",
      "as": "Policy_Era"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.2,
        "opacity": 0.75,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Commencements",
          "type": "quantitative",
          "title": "Quarterly Commencements (New Enrolments)",
          "scale": {"zero": false}
        },
        "y": {
          "field": "Completions",
          "type": "quantitative",
          "title": "Quarterly Completions (Graduates)",
          "scale": {"zero": false}
        },
        "order": {"field": "Period"},
        "color": {
          "field": "Policy_Era",
          "type": "nominal",
          "scale": {
            "domain": [
              "Pre-Pandemic Baseline (2016-19)",
              "COVID Wage Subsidy Boom (2020-22)",
              "Post-Subsidy Contraction (2023-25)"
            ],
            "range": ["#64748b", "#0284c7", "#ef4444"]
          },
          "legend": {
            "title": "Policy Era",
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 65,
        "opacity": 0.9
      },
      "encoding": {
        "x": {"field": "Commencements", "type": "quantitative"},
        "y": {"field": "Completions", "type": "quantitative"},
        "color": {"field": "Policy_Era", "type": "nominal"},
        "tooltip": [
          {"field": "Period", "type": "nominal", "title": "Quarter"},
          {"field": "Commencements", "type": "quantitative", "format": ",", "title": "Commencements"},
          {"field": "Completions", "type": "quantitative", "format": ",", "title": "Completions"},
          {"field": "In_Training", "type": "quantitative", "format": ",", "title": "In Training"},
          {"field": "Policy_Era", "type": "nominal", "title": "Era"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "commence": 71705,
            "comp": 22495,
            "text": "2020-Q4: BAC Subsidy Peak (71.7k)",
            "align": "right",
            "dx": -10,
            "dy": -10
          },
          {
            "commence": 22295,
            "comp": 14825,
            "text": "2020-Q2: Lockdown Trough",
            "align": "left",
            "dx": 8,
            "dy": -8
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Plus Jakarta Sans, sans-serif",
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {"field": "commence", "type": "quantitative"},
        "y": {"field": "comp", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"},
        "align": {"field": "align", "type": "nominal"},
        "dx": {"field": "dx", "type": "quantitative"},
        "dy": {"field": "dy", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "axis": {
      "labelFont": "Plus Jakarta Sans, sans-serif",
      "titleFont": "Plus Jakarta Sans, sans-serif",
      "gridColor": "#f1f5f9"
    }
  }
}
